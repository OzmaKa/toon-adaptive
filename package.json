{
  "name": "toon-adaptive",
  "version": "0.1.0",
  "description": "Decides whether a JSON payload should go to an LLM as TOON or stay JSON, using real token measurement instead of guesswork.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/structural.test.js dist/decision.test.js dist/fixtures.test.js"
  },
  "keywords": [
    "toon",
    "llm",
    "token-optimization",
    "json",
    "typescript",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "type": "commonjs",
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "js-tiktoken": "^1.0.21"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/run-*"
  ],
  "engines": {
    "node": ">=22.12"
  }
}